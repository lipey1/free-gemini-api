# Obrigatório — chave para assinar JWTs de sessão Gemini (gere uma string longa e aleatória)
SESSION_SECRET=sua-chave-secreta-aqui

# Obrigatório para login/conta — se vazio, cai no SESSION_SECRET
AUTH_SECRET=sua-chave-auth-aqui

# Porta do servidor (padrão: 3333)
PORT=3333

# URL pública do site (links de e-mail, Stripe success/cancel)
PUBLIC_BASE_URL=http://localhost:3333

# Cookie Secure (force true atrás de HTTPS)
# COOKIE_SECURE=true

# Se true, envolve cada prompt do usuário com src/config/default_prompt.txt (${message})
INSERT_PROMPT=false

# Tempo de vida do sessionToken Gemini em minutos (padrão: 45)
SESSION_TTL_MINUTES=45

# Caminho do SQLite de sessões Gemini; vazio usa data/sessions.sqlite
SESSION_DB_PATH=

# Caminho do SQLite de usuários/billing; vazio usa data/app.sqlite
APP_DB_PATH=

# E-mail que recebe role admin no registro (opcional)
ADMIN_EMAIL=

# Rate limits (0 = desativado para aquele endpoint)
# Free anônimo / fallback = 20 req/min (planos pagos sobrescrevem por usuário)
RATE_LIMIT_CREATE_SESSION_INTERVAL_SEC=15
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_STATUS_PER_MINUTE=60

# Stripe (assinaturas recorrentes BRL)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MEGA=
STRIPE_PRICE_MAX=
STRIPE_PRICE_ULTRA=

# SMTP para recuperação de senha (sem isso, o link é logado no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
